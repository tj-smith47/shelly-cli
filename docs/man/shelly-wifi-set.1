.nh
.TH "SHELLY" "1" "Oct 2026" "Shelly CLI" "User Commands"

.SH NAME
shelly-wifi-set - Configure WiFi connection


.SH SYNOPSIS
\fBshelly wifi set  [flags]\fP


.SH DESCRIPTION
Configure the WiFi station (client) connection for a device.

.PP
Set the SSID and password to connect to a WiFi network. Optionally configure
static IP settings instead of using DHCP.

.PP
Without --password, a device that stays on the same network keeps the
password it has. A different network takes the password this host has stored
for it; with none, the command is refused. Use --open for a network that has
no password.


.SH OPTIONS
\fB--disable\fP[=false]
	Disable WiFi station mode

.PP
\fB--dns\fP=""
	Static IPv4 nameserver (with --static-ip; default: the device's current one)

.PP
\fB--enable\fP[=false]
	Enable WiFi station mode

.PP
\fB--gateway\fP=""
	Static IPv4 default gateway (with --static-ip; default: the device's current one)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for set

.PP
\fB--netmask\fP=""
	Static IPv4 subnet mask (with --static-ip; default: the device's current one)

.PP
\fB--open\fP[=false]
	Join a network that has no password

.PP
\fB--password\fP=""
	WiFi password for the network (when omitted and one is needed, the passphrase stored on this host for it is used)

.PP
\fB--ssid\fP=""
	WiFi network name

.PP
\fB--static-ip\fP=""
	Static IPv4 address (DHCP when not set; --gateway, --netmask and --dns default to the device's current ones)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Config file (default $HOME/.config/shelly/config.yaml)

.PP
\fB-F\fP, \fB--fields\fP[=false]
	Print available field names for use with --jq and --template

.PP
\fB-Q\fP, \fB--jq\fP=[]
	Apply jq expression to filter output (repeatable, joined with |)

.PP
\fB--log-categories\fP=""
	Filter logs by category (comma-separated: network,api,device,config,auth,plugin)

.PP
\fB--log-json\fP[=false]
	Output logs in JSON format

.PP
\fB--no-color\fP[=false]
	Disable colored output

.PP
\fB--no-headers\fP[=false]
	Hide table headers in output

.PP
\fB--offline\fP[=false]
	Only read from cache, error on cache miss

.PP
\fB-o\fP, \fB--output\fP="table"
	Output format (table, json, yaml, template)

.PP
\fB--plain\fP[=false]
	Disable borders and colors (machine-readable output)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--raw\fP[=false]
	Print the exact device response(s) as a JSON array and suppress normal output

.PP
\fB--refresh\fP[=false]
	Bypass cache and fetch fresh data from device

.PP
\fB--template\fP=""
	Go template string for output (use with -o template)

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	Increase verbosity (-v=info, -vv=debug, -vvv=trace)


.SH EXAMPLE
.EX
  # Connect to a WiFi network
  shelly wifi set living-room --ssid "MyNetwork" --password "secret"

  # Join a network this host knows, using its stored password
  shelly wifi set living-room --ssid "MyNetwork"

  # Join a network that has no password
  shelly wifi set living-room --ssid "GuestNet" --open

  # Configure static IP
  shelly wifi set living-room --ssid "MyNetwork" --password "secret" \\
    --static-ip "192.168.1.50" --gateway "192.168.1.1" --netmask "255.255.255.0"

  # Change only the address; the gateway and netmask stay the device's
  shelly wifi set living-room --ssid "MyNetwork" --static-ip "192.168.1.51"

  # Disable WiFi station mode
  shelly wifi set living-room --disable
.EE


.SH SEE ALSO
\fBshelly-wifi(1)\fP
